# Public values from Supabase Project Settings > API. The publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Server-only secret used for trusted marking writes. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
# Server-only secret mixed into class-code hashes. Generate a long random value in production.
CLASS_CODE_PEPPER=replace_with_a_long_random_secret
# Set true for the local showcase when Supabase is not configured; progress stays on this device.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Billing. Keep all secret values server-only and use test-mode values initially.
STRIPE_MODE=test
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_STUDENT_PLUS_MONTHLY_PRICE_ID=price_replace_me
STRIPE_STUDENT_PLUS_ANNUAL_PRICE_ID=price_replace_me
STRIPE_TEACHER_PRO_MONTHLY_PRICE_ID=price_replace_me
STRIPE_TEACHER_PRO_ANNUAL_PRICE_ID=price_replace_me
# Optional separate Customer Portal configurations prevent cross-family plan changes.
STRIPE_STUDENT_PORTAL_CONFIGURATION_ID=
STRIPE_TEACHER_PORTAL_CONFIGURATION_ID=
